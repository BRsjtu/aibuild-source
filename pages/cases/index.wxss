page {
  height: 100%;
  background: #f7f8fc;
  color: #111827;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
}

button::after {
  border: none;
}

.scrollarea {
  height: calc(100vh - 88rpx);
}

.page {
  padding: 24rpx;
  box-sizing: border-box;
}

.top-nav {
  display: flex;
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.nav-chip {
  flex: 1;
  text-align: center;
  padding: 18rpx 12rpx;
  border-radius: 18rpx;
  background: #ffffff;
  color: #475569;
  font-size: 28rpx;
  border: 2rpx solid #e2e8f0;
}

.nav-chip-active {
  background: #111827;
  color: #ffffff;
  border-color: #111827;
}

.hero-card,
.card,
.case-card {
  background: #ffffff;
  border-radius: 24rpx;
  box-sizing: border-box;
  box-shadow: 0 8rpx 24rpx rgba(15, 23, 42, 0.06);
}

.hero-card,
.card {
  padding: 28rpx;
  margin-bottom: 24rpx;
}

.hero-card {
  background: linear-gradient(135deg, #ecfeff 0%, #ffffff 100%);
  border: 2rpx solid rgba(8, 145, 178, 0.1);
}

.hero-title {
  font-size: 42rpx;
  font-weight: 700;
}

.hero-desc,
.empty-desc,
.case-subtitle,
.case-highlight {
  margin-top: 10rpx;
  font-size: 28rpx;
  line-height: 1.7;
  color: #475569;
}

.empty-card {
  text-align: center;
}

.empty-title {
  font-size: 32rpx;
  font-weight: 700;
}

.case-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.case-card {
  overflow: hidden;
}

.case-cover-shell {
  width: 100%;
  height: 260rpx;
  background: linear-gradient(135deg, #e2e8f0 0%, #f8fafc 100%);
}

.case-cover {
  width: 100%;
  height: 100%;
  display: block;
}

.case-cover-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #64748b;
  font-size: 28rpx;
}

.case-body {
  padding: 24rpx;
}

.case-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #111827;
}

.case-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 14rpx;
}

.case-tag {
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: #ecfeff;
  color: #0f766e;
  font-size: 24rpx;
  font-weight: 600;
}

.case-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 18rpx;
}

.primary-btn,
.ghost-btn {
  flex: 1;
  border-radius: 18rpx;
  font-size: 28rpx;
}

.primary-btn {
  background: #111827;
  color: #ffffff;
}

.ghost-btn {
  background: #ffffff;
  color: #374151;
  border: 2rpx solid #d1d5db;
}

.load-more-tip {
  padding: 18rpx 0 28rpx;
  text-align: center;
  color: #64748b;
  font-size: 24rpx;
}
