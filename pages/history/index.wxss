page {
  height: 100%;
  background: #f7f8fc;
  color: #111827;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
}

.scrollarea {
  height: calc(100vh - 88rpx);
}

.page {
  padding: 24rpx;
  box-sizing: border-box;
}

.top-nav {
  display: flex;
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.nav-chip {
  flex: 1;
  text-align: center;
  padding: 18rpx 12rpx;
  border-radius: 18rpx;
  background: #ffffff;
  color: #475569;
  font-size: 28rpx;
  border: 2rpx solid #e2e8f0;
}

.nav-chip-active {
  background: #111827;
  color: #ffffff;
  border-color: #111827;
}

.hero-card,
.card,
.history-card {
  background: #ffffff;
  border-radius: 24rpx;
  box-sizing: border-box;
  box-shadow: 0 8rpx 24rpx rgba(15, 23, 42, 0.06);
}

.hero-card,
.card {
  padding: 28rpx;
  margin-bottom: 24rpx;
}

.hero-card {
  background: linear-gradient(135deg, #fff7ed 0%, #ffffff 100%);
  border: 2rpx solid rgba(234, 88, 12, 0.1);
}

.hero-title,
.empty-title {
  font-size: 42rpx;
  font-weight: 700;
}

.hero-desc,
.empty-desc,
.history-meta,
.history-status {
  margin-top: 10rpx;
  font-size: 28rpx;
  line-height: 1.7;
  color: #475569;
}

.history-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.history-card {
  overflow: hidden;
}

.history-cover-shell {
  height: 220rpx;
  background: #e2e8f0;
}

.history-cover {
  width: 100%;
  height: 100%;
}

.history-cover-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #64748b;
  font-size: 28rpx;
}

.history-body {
  padding: 22rpx 24rpx 26rpx;
}

.history-title {
  font-size: 32rpx;
  font-weight: 700;
}

.history-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 12rpx;
}

.history-tag {
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: #f1f5f9;
  color: #334155;
  font-size: 24rpx;
}
