page {
  height: 100%;
  background: #f7f8fc;
  color: #111827;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
}

button::after {
  border: none;
}

.scrollarea {
  height: calc(100vh - 88rpx);
}

.page {
  padding: 24rpx;
  box-sizing: border-box;
}

.hero-card,
.card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 28rpx;
  box-sizing: border-box;
  box-shadow: 0 8rpx 24rpx rgba(15, 23, 42, 0.06);
  margin-bottom: 24rpx;
}

.hero-card {
  background: linear-gradient(135deg, #eef2ff 0%, #ffffff 100%);
  border: 2rpx solid rgba(79, 70, 229, 0.08);
}

.hero-title,
.section-title,
.empty-title {
  font-size: 36rpx;
  font-weight: 700;
}

.hero-meta,
.empty-desc {
  margin-top: 10rpx;
  font-size: 28rpx;
  line-height: 1.7;
  color: #475569;
}

.tag-group,
.action-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.soft-tag {
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: #eef2ff;
  color: #4338ca;
  font-size: 24rpx;
}

.image-shell {
  width: 100%;
  height: 420rpx;
  border-radius: 20rpx;
  background: #f1f5f9;
  border: 2rpx solid #e2e8f0;
  overflow: hidden;
}

.image-block {
  width: 100%;
  height: 100%;
}

.original-photo-placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 32rpx;
  box-sizing: border-box;
  text-align: center;
}

.placeholder-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #334155;
}

.placeholder-desc {
  margin-top: 8rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: #64748b;
}

.image-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
}

.original-photo-grid {
  margin-top: 16rpx;
}

.image-grid-card {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.grid-card-title {
  font-size: 24rpx;
  line-height: 1.5;
  color: #334155;
  font-weight: 600;
}

.small-image-shell {
  height: 240rpx;
}

.markdown-panel {
  background: #f8fafc;
  border-radius: 18rpx;
  padding: 22rpx 24rpx;
  border: 2rpx solid #e2e8f0;
}

.markdown-heading {
  color: #111827;
  font-weight: 700;
  font-size: 32rpx;
  line-height: 1.6;
  margin: 20rpx 0 12rpx;
}

.markdown-paragraph,
.markdown-list-text {
  color: #334155;
  font-size: 28rpx;
  line-height: 1.9;
  margin: 10rpx 0;
}

.markdown-list {
  margin: 8rpx 0 16rpx;
}

.markdown-list-item {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  margin: 8rpx 0;
}

.markdown-list-marker {
  width: 28rpx;
  flex: none;
  font-size: 28rpx;
  line-height: 1.9;
  color: #4f46e5;
  font-weight: 700;
}

.primary-btn,
.ghost-btn {
  flex: 1;
  border-radius: 18rpx;
  font-size: 28rpx;
}

.primary-btn {
  background: #dc2626;
  color: #ffffff;
}

.ghost-btn {
  background: #ffffff;
  color: #374151;
  border: 2rpx solid #d1d5db;
}

.full-btn {
  width: 100%;
  margin-top: 16rpx;
}

.error-box {
  margin-top: 16rpx;
  padding: 18rpx 20rpx;
  border-radius: 18rpx;
  background: #fef2f2;
  color: #b91c1c;
  font-size: 26rpx;
  line-height: 1.7;
}

.empty-card {
  text-align: center;
}
