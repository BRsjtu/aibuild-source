page {
  height: 100%;
  background: #f7f8fc;
  color: #111827;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
}

button::after {
  border: none;
}

.scrollarea {
  height: calc(100vh - 88rpx);
}

.page {
  padding: 24rpx;
  box-sizing: border-box;
}

.hero-card,
.card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 28rpx;
  box-sizing: border-box;
  box-shadow: 0 8rpx 24rpx rgba(15, 23, 42, 0.06);
  margin-bottom: 24rpx;
}

.hero-card {
  background: linear-gradient(135deg, #f0fdf4 0%, #ffffff 100%);
  border: 2rpx solid rgba(22, 163, 74, 0.1);
}

.hero-title,
.section-title,
.empty-title {
  font-size: 36rpx;
  font-weight: 700;
}

.hero-desc,
.detail-text,
.empty-desc {
  margin-top: 12rpx;
  font-size: 28rpx;
  line-height: 1.8;
  color: #475569;
}

.case-tags,
.tag-group,
.action-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.case-tags,
.tag-group {
  margin-top: 16rpx;
}

.case-tag,
.soft-tag {
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 600;
}

.case-tag {
  background: #dcfce7;
  color: #166534;
}

.soft-tag {
  background: #eff6ff;
  color: #1d4ed8;
}

.image-shell {
  width: 100%;
  height: 360rpx;
  border-radius: 20rpx;
  overflow: hidden;
  background: #e5e7eb;
  margin-bottom: 16rpx;
}

.image-block {
  width: 100%;
  height: 100%;
  display: block;
}

.action-row {
  margin-top: 10rpx;
}

.primary-btn,
.ghost-btn {
  flex: 1;
  border-radius: 18rpx;
  font-size: 28rpx;
}

.primary-btn {
  background: #111827;
  color: #ffffff;
}

.ghost-btn {
  background: #ffffff;
  color: #374151;
  border: 2rpx solid #d1d5db;
}

.empty-card {
  text-align: center;
}
